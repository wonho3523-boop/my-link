rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 로그인 여부 확인 함수
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 문서 소유자(본인) 여부 확인 함수
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 유저 프로필 정보 (users/{userId})
    match /users/{userId} {
      // 읽기 권한: 누구나 허용 (공개 프로필 조회 및 중복성 검사 쿼리 지원)
      allow read: if true;
      
      // 쓰기 권한: 로그인된 본인만 허용 및 데이터 정합성 검증
      allow write: if isOwner(userId)
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() >= 2
                    && request.resource.data.displayName.size() <= 20
                    && request.resource.data.username is string
                    && request.resource.data.username.matches('^[a-z0-9_]{2,20}$')
                    && (
                         !('bio' in request.resource.data) || 
                         request.resource.data.bio == null || 
                         (request.resource.data.bio is string && request.resource.data.bio.size() <= 200)
                       );

      // 유저 링크 리스트 (users/{userId}/links/{linkId})
      match /links/{linkId} {
        // 읽기 권한: 누구나 허용
        allow read: if true;
        
        // 생성 권한: 로그인된 본인만 허용 및 데이터 유효성 검증
        allow create: if isOwner(userId)
                      && request.resource.data.title is string
                      && request.resource.data.title.size() >= 2
                      && request.resource.data.title.size() <= 20
                      && request.resource.data.url is string
                      && request.resource.data.url.matches('^https?://.+');
        
        // 수정 권한: 본인 수정 또는 타인의 클릭 수(clicks) 1 증가 업데이트 허용
        allow update: if (
                        isOwner(userId)
                        && request.resource.data.title is string
                        && request.resource.data.title.size() >= 2
                        && request.resource.data.title.size() <= 20
                        && request.resource.data.url is string
                        && request.resource.data.url.matches('^https?://.+')
                      ) || (
                        // clicks 필드만 업데이트되는 경우
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
                        && (
                          // 기존에 clicks 필드가 없었으면 1로 초기화, 있었으면 1 증가
                          (!('clicks' in resource.data) && request.resource.data.clicks == 1)
                          || (resource.data.clicks is number && request.resource.data.clicks == resource.data.clicks + 1)
                        )
                      );
                      
        // 삭제 권한: 로그인된 본인만 허용
        allow delete: if isOwner(userId);
      }
    }
  }
}
